<Window x:Class="InfernoWin.NewVmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New iPhone VM" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18">
        <TextBlock Text="Name" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,12"/>

        <TextBlock Text="Device and iOS version" FontWeight="SemiBold"/>
        <ComboBox x:Name="EntryBox" Margin="0,4,0,4" SelectionChanged="EntryBox_SelectionChanged"/>
        <CheckBox x:Name="ExperimentalBox" Content="Show experimental versions" Margin="0,0,0,12"
                  Checked="ExperimentalBox_Changed" Unchecked="ExperimentalBox_Changed"/>

        <CheckBox x:Name="JailbreakBox" Content="Jailbreak (root shell in the Console, apt/Zebra)" Margin="0,0,0,6"/>
        <TextBlock x:Name="Note" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Create" Width="90" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
